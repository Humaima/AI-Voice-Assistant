# --- App ---
APP_NAME=voice-ai-assistant
ENVIRONMENT=development        # development | staging | production
LOG_LEVEL=INFO

# --- Groq (Whisper + Llama) ---
GROQ_API_KEY=your_groq_api_key_here
GROQ_WHISPER_MODEL=whisper-large-v3
GROQ_LLM_MODEL=llama-3.3-70b-versatile

# --- ElevenLabs (TTS) ---
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
ELEVENLABS_VOICE_ID=your_voice_id_here
ELEVENLABS_MODEL=eleven_flash_v2_5

# --- WhatsApp (Meta Cloud API) ---
# Not used — this project uses Twilio for WhatsApp (see below). Kept
# here only in case you want to switch to calling Meta's Cloud API
# directly later; app/api/webhook.py doesn't read these.
WHATSAPP_VERIFY_TOKEN=some_random_verify_token
WHATSAPP_ACCESS_TOKEN=your_meta_access_token_here
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id_here
WHATSAPP_API_VERSION=v20.0

# --- Twilio (Phase 9's actual WhatsApp path) ---
# Get these from your Twilio Console (console.twilio.com) — Account
# SID and Auth Token are on the dashboard homepage. See the README's
# Phase 9 setup walkthrough for the full step-by-step.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_NUMBER=

# --- WhatsApp webhook (Phase 9) ---
# The public HTTPS URL Twilio can reach this server at. During local
# development this is your ngrok URL (see README) — it changes every
# time you restart ngrok on the free tier, so you'll update this and
# the Twilio Console's webhook URL together each session.
PUBLIC_BASE_URL=
MEDIA_STORAGE_DIR=media_storage
MEDIA_FILE_TTL_SECONDS=3600

# --- PostgreSQL ---
# DATABASE_URL is now BUILT AUTOMATICALLY from these values — you only
# ever need to edit the fields below, never a connection string
# directly. (If you need a fully custom connection string, e.g. a
# managed cloud Postgres, set DATABASE_URL_OVERRIDE instead — it takes
# priority over everything below when set.)
#
# NOTE: these defaults assume you're running Postgres/ChromaDB via
# `docker compose up` and the app *locally* via `uvicorn` (the
# workflow used through Phase 4) — so they point at the ports exposed
# to your host machine. If you instead run the app itself inside
# docker-compose too, docker-compose.yml overrides POSTGRES_HOST/
# CHROMA_HOST with the container-network hostnames for you — no manual
# change needed either way.
POSTGRES_USER=voiceai
POSTGRES_PASSWORD=voiceai_pw
POSTGRES_DB=voiceai_db
POSTGRES_HOST=localhost
# Default port is 5433, not Postgres's usual 5432 — deliberately, to
# avoid clashing with a natively-installed Postgres service (very
# common on Windows, where installers often set one up as an
# auto-starting background service on the standard port). If you're
# certain nothing else uses 5432 on your machine, you can change both
# this and POSTGRES_HOST_PORT below to 5432 — but there's no downside
# to leaving it on 5433, so it's the safer default.
POSTGRES_PORT=5433
DATABASE_URL_OVERRIDE=
# The host-exposed port docker-compose publishes (left side of the
# "5433:5432" mapping) — must match POSTGRES_PORT above. The container-
# internal port stays 5432 regardless (used for app<->postgres traffic
# inside the docker-compose network, unaffected by this setting).
POSTGRES_HOST_PORT=5433

# --- Redis ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# --- ChromaDB ---
CHROMA_HOST=localhost
CHROMA_PORT=8001
CHROMA_COLLECTION=conversation_memory

# --- Production hardening (Phase 10) ---
# When set, /audio/*, /agent/*, /tts/* debug routers require this
# exact value in an X-Debug-Token header — but ONLY when ENVIRONMENT
# below is "production". Leave empty locally; leave empty in
# production too if you want debug routes disabled entirely (safest).
DEBUG_API_TOKEN=

# --- Media storage backend (Phase 10) ---
# "local" (default) writes to MEDIA_STORAGE_DIR on local disk — fine
# for development, but most deployment platforms have EPHEMERAL
# filesystems, so switch to "s3" before deploying for real. See
# app/services/media_store.py's docstring for why this matters.
MEDIA_STORAGE_BACKEND=local
S3_BUCKET_NAME=
S3_REGION=us-east-1
# Leave empty for real AWS S3; set for S3-compatible providers (e.g.
# Cloudflare R2's account-specific endpoint, Backblaze B2, MinIO).
S3_ENDPOINT_URL=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# --- LangSmith (optional observability) ---
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=voice-ai-assistant
